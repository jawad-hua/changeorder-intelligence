GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: vision-capable model used ONLY for direct image uploads.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
MAX_UPLOAD_MB=10
ENABLE_RECOVERY_PASS=true
CORS_ORIGINS=http://localhost:3000

# Optional on Windows if tesseract.exe is not on PATH:
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Default OCR language (requires matching Tesseract language data):
OCR_LANGUAGE=eng
